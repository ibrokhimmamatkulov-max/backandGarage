APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Общая БД с другим Laravel-проектом: User/Employee и Passport-таблицы
# (oauth_clients/oauth_access_tokens/...) читаются/пишутся отсюда, чтобы
# токены, выпущенные тем проектом, были валидны и здесь.
DB_CONNECTION_TAXI=mysql
DB_HOST_TAXI=127.0.0.1
DB_PORT_TAXI=3306
DB_DATABASE_TAXI=
DB_USERNAME_TAXI=
DB_PASSWORD_TAXI=

# Passport теперь полностью свой (см. config/passport.php) — раньше эти
# значения должны были совпадать с другим проектом на mysql_taxi, это
# больше не так. PASSPORT_PRIVATE_KEY/PUBLIC_KEY можно оставить пустыми,
# тогда Passport сам сгенерирует ключи в storage/ при первом запуске
# (см. docker/render/entrypoint.sh). GRANT_CLIENT_ID/SECRET — id и секрет
# password-grant OAuth-клиента для входа менеджера: любые значения на ваш
# выбор, ID должен быть 1 (см. миграцию 2026_09_26_000002), секрет должен
# совпасть с тем, что подставится в этой же переменной при первом деплое
# (миграция читает её один раз и создаёт клиента).
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
PASSPORT_GRANT_CLIENT_ID=1
PASSPORT_GRANT_CLIENT_SECRET=

# Пароль первого админа/менеджера. Читается один раз миграцией
# 2026_09_26_000002 при первом деплое на чистую базу — задать до первого
# запуска, после можно оставить как есть или убрать из окружения.
INITIAL_ADMIN_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Логин/пароль для HTTP Basic Auth на странице api/docs (Swagger UI)
L5_SWAGGER_DOCS_USERNAME=
L5_SWAGGER_DOCS_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Гараж 2.0 ---
# Режим OTP: sms | stub. Боевое значение — sms.
# ВНИМАНИЕ: при stub войти можно под ЛЮБЫМ номером телефона.
# На публичном домене держать нельзя.
OTP_MODE=stub
OTP_STUB_CODE=0000
OTP_ALLOW_STUB_IN_PRODUCTION=false

# Драйвер SMS: log | stub | provider. Провайдер для TJ ещё не выбран.
SMS_DRIVER=log
SMS_SENDER_NAME=Garage
SMS_API_URL=
SMS_API_KEY=

# Срок жизни токена кабинета арендодателя, минут (30 дней)
SANCTUM_EXPIRATION_MINUTES=43200
